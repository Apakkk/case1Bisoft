# Copy to .env and fill in the secrets. .env is git-ignored.

# PostgreSQL (docker-compose service "db")
POSTGRES_USER=carrier
POSTGRES_PASSWORD=carrier
POSTGRES_DB=carrier
DATABASE_URL=postgresql://carrier:carrier@localhost:5433/carrier

# Jev via the official typesafe-sdk (reads TYPESAFE_API_KEY natively).
# Required for free-text orders and carrier-note checks.
TYPESAFE_API_KEY=
# Pinned model version: the confidence thresholds in config/rules.yaml were measured on it.
# Empty uses the app default (jev-1.14.0); `make smoke-jev` lists the models.
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=5

# OpenRouteService - optional; without it off-table routes fall back to Haversine.
ORS_API_KEY=

# Selection rules
RULES_PATH=config/rules.yaml

# Login (required): one account guards every page and the API (browser: /login; API clients: HTTP Basic).
# Not in the code on purpose; the app does not start without them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the session cookie. Empty -> a random key per start, so every restart logs everyone out.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
